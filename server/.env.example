# Backend Environment Variables - Multi-Vendor Platform
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (supports both names for compatibility)
MONGODB_URI=mongodb://localhost:27017/ecommerce
MONGO_URI=mongodb://localhost:27017/ecommerce

# JWT Configuration (access + refresh)
# IMPORTANT: Use strong, random secrets (at least 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET
JWT_EXPIRE=7d
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# CORS Configuration - comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Image Upload Configuration (local fallback)
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Cloudinary (production image storage — optional for local dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments — clean service architecture (razorpay | stripe | cod)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_XXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email Configuration (choose one set)
# Inbox for contact-form notifications (independent of FROM address):
# CONTACT_NOTIFY_TO=you@gmail.com
CONTACT_NOTIFY_TO=
# Option 1: Generic SMTP (used by config/email.js)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password (Gmail App Password, not login password)
FROM_EMAIL=noreply@atelier.com
FROM_NAME=Atelier Shop
STORE_NAME=ShopAtelier

# Option 2: Nodemailer simple (used by utils/sendEmail.js - kept for compatibility)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password (Gmail App Password, not login password)

